# Kopieer naar .env en vul in. .env staat in .gitignore.
TZ=Europe/Amsterdam

# Omada controller + Open API-client (Omada: Instellingen > Platformintegratie > Open API, client credentials)
OMADA_URL=https://10.0.0.2:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=

# Optioneel: aparte Omada-gebruiker voor type/merk/model en switchpoort-controle (web-API)
OMADA_WEB_USER=
OMADA_WEB_PASS=

# Wachtwoord om in te loggen op de portal
PORTAL_PASSWORD=
